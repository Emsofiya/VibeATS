# ── Supabase ─────────────────────────────────────────────────────────────────
# Find these in your Supabase project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-role key (server-side only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Anthropic ─────────────────────────────────────────────────────────────────
# Find this at https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-...

# ── App ───────────────────────────────────────────────────────────────────────
# The email address that acts as super admin (set this to your own email)
SUPER_ADMIN_EMAIL=admin@youragency.com

# ── Site URL (used for auth redirects) ────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
